# Copy to .env.production on EC2. Never commit the populated file.
# Single-quote secret values containing $ or # to avoid Compose interpolation.
APP_DOMAIN=calendar.example.com
DB_HOST=your-instance.region.rds.amazonaws.com
DB_PORT=3306
DB_NAME=bangla_calendar
DB_USER=calendar_app
DB_PASSWORD=replace-me
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Preserve your existing VAPID keys when moving an existing deployment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
RESEND_API_KEY=
REMINDER_FROM_EMAIL=Calendar <reminders@example.com>
