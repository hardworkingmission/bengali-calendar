# Used by docker-compose.yml — copy to .env and fill in real values.

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=bangla_calendar

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# From resend.com/api-keys
RESEND_API_KEY=
REMINDER_FROM_EMAIL=Bangla Calendar <onboarding@resend.dev>

# Browser-facing address of the backend (client-side fetch calls use this).
NEXT_PUBLIC_API_URL=http://localhost:4001/api

# Origin(s) allowed to call the API (comma-separated). Must match the host
# port the frontend container is published on (8080 by default; see
# docker-compose.yml if you change it).
FRONTEND_ORIGIN=http://localhost:8080
