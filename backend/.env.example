PORT=4001
FRONTEND_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bangla_calendar

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# From resend.com/api-keys. Without a verified sending domain, Resend only
# lets onboarding@resend.dev deliver to the email address on your Resend account.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=Bangla Calendar <onboarding@resend.dev>
